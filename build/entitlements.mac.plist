<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for the Developer ID (notarized) macOS build.
  Used only by the signed path of .github/workflows/release.yml (see docs/CODE-SIGNING.md).
  - allow-jit / allow-unsigned-executable-memory: V8 and the LibreDWG WebAssembly reader.
  - disable-library-validation: Electron loads its own frameworks and helpers signed by the same team.
  No network-server, camera, microphone or file-system exceptions are needed: files are opened
  through the system dialogs.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>

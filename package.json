{
  "name": "voltcad",
  "version": "0.1.0",
  "description": "2D electrical schematic drafting application (desktop)",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "start": "npm run build && electron .",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "playwright": "^1.49.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "@mlightcad/libredwg-web": "^0.7.14",
    "hershey": "^2.1.7"
  }
}

{
  "name": "jcad-electrical",
  "version": "0.3.0",
  "description": "2D electrical schematic drafting application (desktop)",
  "author": "JCad Electrical contributors",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "start": "npm run build && electron .",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "screenshot": "node scripts/screenshot.mjs",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "build": {
    "appId": "com.jcad.electrical",
    "productName": "JCad Electrical",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "scripts/dwg-reader.mjs",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@mlightcad/libredwg-web/**",
      "scripts/**"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "hardenedRuntime": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "maintainer": "JCad Electrical <maintainer@jcad.invalid>",
      "synopsis": "2D electrical schematic drafting"
    },
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "habit04",
      "repo": "share",
      "releaseType": "release"
    },
    "afterPack": "scripts/afterPack.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.49.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "@mlightcad/libredwg-web": "^0.7.14",
    "electron-updater": "^6.8.9",
    "hershey": "^2.1.7"
  }
}

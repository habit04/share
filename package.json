{
  "name": "jcad-electrical",
  "version": "0.6.3",
  "description": "2D electrical schematic drafting application (desktop)",
  "author": "JCad Electrical contributors",
  "license": "GPL-3.0-only",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=22.20.0 <23 || >=24.12.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "dev:gpu": "vite --mode gpu-experimental --port 5189",
    "build:gpu": "tsc --noEmit -p tsconfig.json && vite build --mode gpu-experimental",
    "bench:gpu": "node scripts/bench-gpu-renderer.mjs",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:dwg-writer": "node scripts/build-dwg-writer.mjs",
    "build:site": "node scripts/build-site.mjs",
    "start": "npm run build && electron .",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "pretest": "npm run check:fixtures",
    "test": "vitest run",
    "check:fixtures": "node scripts/check-fixtures.mjs",
    "check:autocad": "node scripts/check-autocad.mjs",
    "check:autocad:3d": "node scripts/check-autocad-3d.mjs",
    "check:dwg-containment": "node scripts/check-dwg-containment.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:electron": "tsc -p tsconfig.electron.json",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "typecheck:all": "npm run typecheck && npm run typecheck:electron && npm run typecheck:scripts",
    "lint": "eslint --max-warnings=0 .",
    "screenshot": "node scripts/screenshot.mjs",
    "screenshot:compare": "node scripts/screenshot-compare.mjs",
    "screenshot:approve": "node scripts/screenshot-compare.mjs --approve",
    "ui-check": "node scripts/ui-click-check.mjs",
    "e2e": "node --experimental-strip-types scripts/e2e-electron.mjs",
    "e2e:packaged": "node --experimental-strip-types scripts/e2e-electron.mjs --packaged",
    "bench": "node scripts/bench.mjs",
    "bench:node": "cross-env JCAD_BENCH=1 vitest run tests/perf-dense.test.ts",
    "bench:3d": "cross-env JCAD_BENCH=1 vitest run tests/perf-3d.test.ts",
    "make:3d-fixtures": "node scripts/make-3d-fixtures.mjs",
    "bench:project": "node scripts/bench-project.mjs",
    "check:workflows": "node scripts/check-workflows.mjs",
    "e2e:flows": "node scripts/e2e-flows.mjs",
    "e2e:origin": "node scripts/e2e-origin.mjs",
    "e2e:2d-batch": "node scripts/e2e-2d-batch.mjs",
    "e2e:3d": "node scripts/e2e-3d.mjs",
    "e2e:3d-security": "node scripts/e2e-3d-security.mjs",
    "dist": "npm run build && npm run build:dwg-writer && electron-builder",
    "dist:dir": "npm run build && npm run build:dwg-writer && electron-builder --dir",
    "dist:test": "npm run build && npm run build:dwg-writer && electron-builder --dir --config scripts/electron-test-build.cjs --publish never",
    "dist:test:no-dwg": "npm run build && cross-env JCAD_TEST_BUILD_WITHOUT_DWG_WRITER=1 electron-builder --dir --config scripts/electron-test-build.cjs --publish never",
    "e2e:test-build": "node scripts/test-build-e2e.mjs",
    "icons": "node scripts/make-icons.mjs",
    "release-notes": "node scripts/release-notes.mjs"
  },
  "build": {
    "appId": "com.jcad.electrical",
    "productName": "JCad Electrical",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false,
      "resetAdHocDarwinSignature": true
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "LICENSE",
      "THIRD-PARTY-NOTICES.md",
      "dist/**",
      "electron/**",
      "scripts/dwg-reader.mjs",
      "scripts/dwg-native-read.mjs",
      "scripts/dwg-native-metadata.mjs",
      "scripts/dwg-metadata-equivalence.mjs",
      "scripts/dwg-mtext-background.mjs",
      "scripts/dwg-array-conversion.mjs",
      "scripts/dwg-appearance-conversion.mjs",
      "scripts/dwg-worker.mjs",
      "scripts/dwg-process.mjs",
      "scripts/dwg-wasm-memory.mjs",
      {
        "from": "vendor/libredwg-web-bg",
        "to": "vendor/libredwg-web-bg",
        "filter": [
          "**/*"
        ]
      },
      "package.json",
      "!node_modules/@napi-rs/canvas/**",
      "!node_modules/@napi-rs/canvas-*/**"
    ],
    "asarUnpack": [
      "electron/dwg-protocol.cjs",
      "node_modules/@mlightcad/libredwg-web/**",
      "vendor/libredwg-web-bg/**",
      "scripts/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signExts": [
        "!JcadDwgWriter.exe"
      ],
      "extraResources": [
        {
          "from": "release/dwg-writer",
          "to": "dwg-writer",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": false,
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "maintainer": "JCad Electrical <maintainer@jcad.invalid>",
      "synopsis": "2D electrical schematic drafting",
      "icon": "build/icons"
    },
    "fileAssociations": [
      {
        "ext": "dxf",
        "name": "DXF Drawing",
        "description": "DXF drawing",
        "mimeType": "image/vnd.dxf",
        "role": "Editor"
      },
      {
        "ext": "jcadproj.json",
        "name": "JCad Electrical Project",
        "description": "JCad Electrical project",
        "mimeType": "application/x-jcad-electrical-project+json",
        "role": "Editor"
      }
    ],
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "habit04",
      "repo": "share",
      "releaseType": "release"
    },
    "afterPack": "scripts/afterPack.cjs"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^9.39.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "manifold-3d": "3.5.4",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.49.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.0.3",
    "vitest": "^5.0.3",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "@mlightcad/libredwg-web": "^0.7.14",
    "electron-updater": "^6.8.9",
    "hershey": "^2.1.7",
    "js-yaml": "^4.3.2",
    "pdfjs-dist": "6.4.299"
  },
  "overrides": {
    "@electron/get": {
      "global-agent": "^4.1.3"
    }
  }
}

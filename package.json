{
  "name": "jcad-electrical",
  "version": "0.4.1",
  "description": "2D electrical schematic drafting application (desktop)",
  "author": "JCad Electrical contributors",
  "license": "GPL-3.0-only",
  "private": true,
  "main": "electron/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:site": "node scripts/build-site.mjs",
    "start": "npm run build && electron .",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "pretest": "npm run check:fixtures",
    "test": "vitest run",
    "check:fixtures": "node scripts/check-fixtures.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:electron": "tsc -p tsconfig.electron.json",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "typecheck:all": "npm run typecheck && npm run typecheck:electron && npm run typecheck:scripts",
    "lint": "eslint --max-warnings=0 .",
    "screenshot": "node scripts/screenshot.mjs",
    "screenshot:compare": "node scripts/screenshot-compare.mjs",
    "screenshot:approve": "node scripts/screenshot-compare.mjs --approve",
    "ui-check": "node scripts/ui-click-check.mjs",
    "e2e": "node --experimental-strip-types scripts/e2e-electron.mjs",
    "e2e:packaged": "node --experimental-strip-types scripts/e2e-electron.mjs --packaged",
    "bench": "node scripts/bench.mjs",
    "bench:node": "cross-env JCAD_BENCH=1 vitest run tests/perf-dense.test.ts",
    "check:workflows": "node scripts/check-workflows.mjs",
    "e2e:flows": "node scripts/e2e-flows.mjs",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "icons": "node scripts/make-icons.mjs",
    "release-notes": "node scripts/release-notes.mjs"
  },
  "build": {
    "appId": "com.jcad.electrical",
    "productName": "JCad Electrical",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "resetAdHocDarwinSignature": true
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "scripts/dwg-reader.mjs",
      "scripts/dwg-worker.mjs",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@mlightcad/libredwg-web/**",
      "scripts/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": false,
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "maintainer": "JCad Electrical <maintainer@jcad.invalid>",
      "synopsis": "2D electrical schematic drafting",
      "icon": "build/icons"
    },
    "fileAssociations": [
      {
        "ext": "dxf",
        "name": "DXF Drawing",
        "description": "DXF drawing",
        "mimeType": "image/vnd.dxf",
        "role": "Editor"
      },
      {
        "ext": "jcadproj.json",
        "name": "JCad Electrical Project",
        "description": "JCad Electrical project",
        "mimeType": "application/x-jcad-electrical-project+json",
        "role": "Editor"
      }
    ],
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "habit04",
      "repo": "share",
      "releaseType": "release"
    },
    "afterPack": "scripts/afterPack.cjs"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^9.39.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "js-yaml": "^4.3.2",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.49.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.0.3",
    "vitest": "^5.0.3",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "@mlightcad/libredwg-web": "^0.7.14",
    "electron-updater": "^6.8.9",
    "hershey": "^2.1.7"
  }
}
